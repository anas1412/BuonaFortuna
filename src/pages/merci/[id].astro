---
import Base from '../../layouts/Base.astro';
import { api, convex } from '../../lib/convex';
import { CONTACT_PHONE, formatPrice, whatsappLink } from '../../lib/shop';
import type { Id } from '../../../convex/_generated/dataModel';

const { id } = Astro.params;
let order = null;
try {
  order = id ? await convex.query(api.orders.confirmation, { id: id as Id<'orders'> }) : null;
} catch {
  // A malformed id throws inside Convex; treat it as not found.
}
if (!order) return Astro.rewrite('/404');

const item = order.items[0];
const total = order.items.reduce((s, i) => s + i.price, 0) + order.deliveryFee;
const wa = CONTACT_PHONE ? whatsappLink(CONTACT_PHONE, `Bonjour, à propos de ma commande ${order.number}`) : null;
---

<Base title={`Commande ${order.number} enregistrée`} description="Votre commande est enregistrée." noindex>
  <section class="container container--narrow thanks">
    <p class="eyebrow">Commande {order.number}</p>
    <h1>Merci {order.customerName.split(' ')[0]}, c'est noté.</h1>
    <p class="thanks__lead">
      Nous vous appelons très vite pour confirmer, puis le colis part vers <strong>{order.city}</strong>.
      Vous réglez <strong>{formatPrice(total)}</strong> en espèces au livreur.
    </p>

    <div class="card thanks__card">
      {item && (
        <div class="thanks__item">
          {item.image && <img src={item.image} alt="" width="72" height="90" />}
          <div>
            <p class="thanks__name">{item.name}</p>
            <p class="small muted">{formatPrice(item.price)} + {formatPrice(order.deliveryFee)} de livraison</p>
          </div>
        </div>
      )}
      <ol class="thanks__steps">
        <li><strong>Nous vous appelons</strong> sous 24 h ouvrées, sur le numéro que vous venez de donner, pour confirmer.</li>
        <li><strong>Expédition</strong> — la pièce est réservée pour vous dès maintenant.</li>
        <li><strong>Livraison et paiement</strong> — comptez 2 à 5 jours selon la région.</li>
      </ol>
    </div>

    <p class="thanks__hint muted">
      Vous n'avez rien d'autre à faire : attendez notre appel.
      {wa && <> Une question avant ? <a href={wa} rel="noopener">Écrivez-nous sur WhatsApp</a>, en indiquant {order.number}.</>}
    </p>

    <a href="/catalogue" class="btn btn--outline">Continuer à chiner</a>
  </section>
</Base>

<style>
  .thanks {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-block: 56px 24px;
  }
  .thanks__lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .thanks__lead strong {
    color: var(--ink);
  }
  .thanks__card {
    width: 100%;
    padding: 20px;
    display: grid;
    gap: 18px;
    margin-top: 8px;
  }
  .thanks__item {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .thanks__item img {
    width: 64px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--line);
  }
  .thanks__name {
    font-weight: 600;
  }
  .thanks__steps {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
    font-size: 14.5px;
    color: var(--ink-soft);
  }
  .thanks__steps strong {
    color: var(--ink);
  }
  .thanks__hint {
    font-size: 14px;
    max-width: 60ch;
  }
  .thanks__hint a {
    color: var(--red);
    font-weight: 600;
  }
</style>
