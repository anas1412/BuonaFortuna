---
/**
 * Product page — the one that has to be right for Google and for WhatsApp.
 * Server-rendered from Convex on every request so availability is never stale.
 */
import Gallery from '../../components/Gallery';
import ProductCard from '../../components/ProductCard.astro';
import Base from '../../layouts/Base.astro';
import { api, convex } from '../../lib/convex';
import { DELIVERY_FEE, SITE_URL, discountPercent, formatPrice, isSecondHand } from '../../lib/shop';

const { slug } = Astro.params;
const product = slug ? await convex.query(api.products.bySlug, { slug }) : null;
if (!product) return Astro.rewrite('/404');

const similar = await convex.query(api.products.similar, { productId: product._id, limit: 4 });

const images = product.images.map((i) => i.url);
const discount = discountPercent(product.price, product.compareAtPrice);
const url = `${SITE_URL}/p/${product.slug}`;
const dinars = (product.price / 1000).toFixed(3);

// Many names already carry the brand ("Trench beige Sandro"); don't say it twice.
const hasBrand = product.name.toLowerCase().includes(product.brand.toLowerCase());
const fullName = hasBrand ? product.name : `${product.name} ${product.brand}`;
const secondHand = isSecondHand(product.condition);
const sizeLabel = secondHand ? 'Taille' : 'Format';
const description = secondHand
  ? `${fullName}, taille ${product.size}, ${product.condition.toLowerCase()} — ${formatPrice(product.price)}. Pièce unique de seconde main, paiement à la livraison en Tunisie.`
  : `${fullName}, ${product.size}, neuf — ${formatPrice(product.price)}. Livraison partout en Tunisie, paiement à la réception.`;
const schemaCondition = secondHand ? 'https://schema.org/UsedCondition' : 'https://schema.org/NewCondition';
const chain = [...product.ancestors, ...(product.category ? [product.category] : [])];

const availability =
  product.status === 'available'
    ? 'https://schema.org/InStock'
    : product.status === 'reserved'
      ? 'https://schema.org/OutOfStock'
      : 'https://schema.org/SoldOut';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    image: images,
    description: product.description,
    sku: product.slug,
    brand: { '@type': 'Brand', name: product.brand },
    itemCondition: schemaCondition,
    category: chain.map((c) => c.name).join(' > ') || undefined,
    url,
    offers: {
      '@type': 'Offer',
      url,
      price: dinars,
      priceCurrency: 'TND',
      availability,
      itemCondition: schemaCondition,
      seller: { '@type': 'Organization', name: 'BuonaFortuna' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
      ...chain.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `${SITE_URL}/c/${c.path}` })),
      { '@type': 'ListItem', position: chain.length + 2, name: product.name, item: url },
    ],
  },
];
---

<Base
  title={secondHand ? `${fullName} · Taille ${product.size}` : `${fullName} · ${product.size}`}
  description={description}
  canonicalPath={`/p/${product.slug}`}
  image={images[0]}
  ogType="product"
  jsonLd={jsonLd}
>
  <article class="container product">
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      {
        chain.map((c) => (
          <>
            <a href={`/c/${c.path}`}>{c.name}</a>
            <span aria-hidden="true">/</span>
          </>
        ))
      }
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="product__grid">
      <div class="product__media">
        <Gallery client:visible images={images} alt={`${product.name}, ${product.brand}, taille ${product.size}`} />
      </div>

      <div class="product__info">
        <p class="eyebrow">{product.brand}</p>
        <h1>{product.name}</h1>

        <p class="product__priceRow">
          <span class="product__price">{formatPrice(product.price)}</span>
          {product.compareAtPrice && <span class="price--was">{formatPrice(product.compareAtPrice)}</span>}
          {discount && <span class="chip chip--red">-{discount}%</span>}
        </p>

        <dl class="specs">
          <div><dt>{sizeLabel}</dt><dd>{product.size}</dd></div>
          <div><dt>État</dt><dd>{product.condition}</dd></div>
          {product.category && <div><dt>Rayon</dt><dd><a href={`/c/${product.category.path}`}>{product.category.name}</a></dd></div>}
        </dl>

        {
          product.status === 'available' ? (
            <a href={`/commander/${product.slug}`} class="btn btn--primary btn--block product__cta">
              Commander — paiement à la livraison
            </a>
          ) : product.status === 'reserved' ? (
            <div class="product__state">
              <span class="chip chip--amber">Réservé</span>
              <p class="muted">Quelqu'un a commandé cette pièce. Si la commande n'aboutit pas, elle sera de nouveau disponible ici.</p>
            </div>
          ) : (
            <div class="product__state">
              <span class="chip chip--ink">Vendu</span>
              <p class="muted">Cette pièce a trouvé preneur. Des articles du même esprit sont juste en dessous.</p>
            </div>
          )
        }

        <ul class="delivery">
          <li><strong>Livraison {formatPrice(DELIVERY_FEE)}</strong> partout en Tunisie</li>
          <li><strong>Paiement en espèces</strong> à la réception du colis</li>
          <li>Nous vous appelons pour <strong>confirmer</strong> avant l'envoi</li>
        </ul>

        <section class="product__desc">
          <h2>Description</h2>
          <p>{product.description}</p>
          {secondHand ? (
            <p class="small muted">Article de seconde main, unique. Photographié tel qu'il est vendu.</p>
          ) : (
            <p class="small muted">Produit neuf, jamais utilisé.</p>
          )}
        </section>
      </div>
    </div>

    {
      similar.length > 0 && (
        <section class="similar">
          <div class="similar__head">
            <h2>Dans le même esprit</h2>
            {product.category && <a href={`/c/${product.category.path}`} class="similar__more">Voir tout « {product.category.name} »</a>}
          </div>
          <div class="grid">
            {similar.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .product {
    padding-block: 20px 8px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-faint);
    margin-bottom: 20px;
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .crumbs [aria-current] {
    color: var(--ink-soft);
  }

  .product__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 40px;
    align-items: start;
  }
  .product__media {
    position: sticky;
    top: 88px;
  }
  .product__info {
    display: grid;
    gap: 18px;
    max-width: 520px;
  }
  .product__info h1 {
    margin-top: -12px;
  }
  .product__priceRow {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .product__price {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--red);
    line-height: 1;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 14px 28px;
    margin: 0;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .specs dt {
    font-size: 12px;
    color: var(--ink-faint);
  }
  .specs dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .specs a {
    color: var(--red);
  }

  .product__cta {
    min-height: 52px;
    font-size: 16px;
  }
  .product__state {
    display: grid;
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
  }
  .product__state .chip {
    justify-self: start;
  }

  .delivery {
    list-style: none;
    margin: 0;
    padding: 14px 16px;
    display: grid;
    gap: 8px;
    background: var(--red-softer);
    border-radius: var(--radius-md);
    font-size: 14px;
    color: var(--ink-soft);
  }
  .delivery strong {
    color: var(--ink);
  }

  .product__desc {
    display: grid;
    gap: 10px;
  }
  .product__desc h2 {
    font-size: 20px;
  }
  .product__desc p {
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .similar {
    margin-top: 64px;
  }
  .similar__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .similar__more {
    font-size: 14px;
    font-weight: 600;
    color: var(--red);
  }

  @media (max-width: 899px) {
    .product__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .product__media {
      position: static;
    }
    .product__info {
      max-width: none;
    }
    .product__info h1 {
      margin-top: -8px;
    }
  }
</style>

<style is:global>
  /* Gallery island styles live here: the island's JSX can't carry scoped CSS. */
  .gallery {
    display: grid;
    gap: 10px;
  }
  .gallery__main {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--line);
  }
  .gallery__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    gap: 8px;
  }
  .gallery__thumb {
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--line);
    cursor: pointer;
    aspect-ratio: 4 / 5;
  }
  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__thumb.is-active {
    border-color: var(--red);
  }
</style>
