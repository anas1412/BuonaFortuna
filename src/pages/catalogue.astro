---
import Catalogue from '../components/Catalogue.astro';
import Base from '../layouts/Base.astro';
import { api, convex } from '../lib/convex';
import { readFilters } from '../lib/filters';

const params = Astro.url.searchParams;
const filters = readFilters(params, { sizes: false });
const { q } = filters;

const [tree, result] = await Promise.all([
  convex.query(api.categories.tree, {}),
  convex.query(api.products.catalogue, filters),
]);

const title = q ? `Recherche : ${q}` : 'Catalogue';
const description = q
  ? `Résultats pour « ${q} ». Pièces uniques, paiement à la livraison en Tunisie.`
  : 'Tout le catalogue BuonaFortuna : vêtements, chaussures, accessoires et beauté, sélectionnés un par un. Paiement à la livraison partout en Tunisie.';

// Filtered views are for people, not for Google — one canonical, no index on variants.
const isFiltered = [...params.keys()].length > 0;
---

<Base title={title} description={description} canonicalPath="/catalogue" noindex={isFiltered}>
  <section class="container page">
    <header class="page__head">
      <h1>{q ? `Résultats pour « ${q} »` : 'Catalogue'}</h1>
      {!q && <p class="muted">Chaque pièce est unique et part vite. Ce que vous voyez est ce qui est disponible aujourd'hui.</p>}
    </header>

    <Catalogue basePath="/catalogue" tree={tree} products={result.products} sizes={result.sizes} params={params} />
  </section>
</Base>

<style>
  .page {
    padding-block: 28px 8px;
  }
  .page__head {
    display: grid;
    gap: 8px;
    margin-bottom: 28px;
  }
  .page__head p {
    max-width: 60ch;
  }
</style>
