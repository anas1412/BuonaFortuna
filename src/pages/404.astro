---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---

<Base title="Page introuvable" description="Cette page n'existe pas ou plus." noindex>
  <section class="container nf">
    <p class="eyebrow">Erreur 404</p>
    <h1>Cette page n'existe pas</h1>
    <p class="muted">Le lien est peut-être ancien, ou l'article a été retiré. Le catalogue, lui, est bien là.</p>
    <div class="nf__actions">
      <a href="/catalogue" class="btn btn--primary">Voir le catalogue</a>
      <a href="/" class="btn btn--ghost">Retour à l'accueil</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding-block: 80px 40px;
    max-width: 52ch;
  }
  .nf__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
</style>
