---
/**
 * Category page: a real landing page with its own URL, heading and paragraph,
 * not just a filtered grid. This is what ranks for "friperie femme Tunisie".
 */
import Catalogue from '../../components/Catalogue.astro';
import Base from '../../layouts/Base.astro';
import { api, convex } from '../../lib/convex';
import { CONDITIONS, SITE_URL, type Condition } from '../../lib/shop';

const { slug } = Astro.params;
const params = Astro.url.searchParams;
const conditions = params.getAll('etat').filter((c): c is Condition => (CONDITIONS as readonly string[]).includes(c));
const sizes = params.getAll('taille');
const tri = params.get('tri');
const sort = tri === 'prix-asc' ? 'priceAsc' : tri === 'prix-desc' ? 'priceDesc' : 'recent';

const [categories, result] = await Promise.all([
  convex.query(api.categories.list, {}),
  convex.query(api.products.catalogue, {
    categorySlug: slug,
    q: params.get('q')?.trim() || undefined,
    conditions: conditions.length ? conditions : undefined,
    sizes: sizes.length ? sizes : undefined,
    sort,
  }),
]);

const category = result.category;
if (!category) return Astro.rewrite('/404');

const isFiltered = [...params.keys()].length > 0;
const cover = result.products[0]?.images[0]?.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Catalogue', item: `${SITE_URL}/catalogue` },
    { '@type': 'ListItem', position: 3, name: category.name, item: `${SITE_URL}/c/${category.slug}` },
  ],
};
---

<Base
  title={`${category.name} de seconde main`}
  description={category.intro}
  canonicalPath={`/c/${category.slug}`}
  image={cover}
  noindex={isFiltered}
  jsonLd={jsonLd}
>
  <section class="container page">
    <nav class="crumbs" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href="/catalogue">Catalogue</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{category.name}</span>
    </nav>

    <header class="page__head">
      <h1>{category.name}</h1>
      <p class="muted">{category.intro}</p>
    </header>

    <Catalogue
      basePath={`/c/${category.slug}`}
      categories={categories}
      activeCategorySlug={category.slug}
      categoryLocked
      products={result.products}
      sizes={result.sizes}
      params={params}
    />
  </section>
</Base>

<style>
  .page {
    padding-block: 20px 8px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-faint);
    margin-bottom: 16px;
  }
  .crumbs a:hover {
    color: var(--red);
  }
  .crumbs [aria-current] {
    color: var(--ink-soft);
  }
  .page__head {
    display: grid;
    gap: 10px;
    margin-bottom: 28px;
  }
  .page__head p {
    max-width: 64ch;
    font-size: 16px;
  }
</style>
