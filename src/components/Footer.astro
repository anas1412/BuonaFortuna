---
import Logo from './Logo.astro';
import { COLLECTIONS } from '../lib/collections';

interface Props {
  departments: { name: string; path: string }[];
}
const { departments } = Astro.props;
const year = new Date().getFullYear();
const deals = COLLECTIONS.filter((c) => c.indexable);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo size={22} />
      <p class="muted">Des pièces uniques, choisies une par une. Livrées chez vous.</p>
      <p class="footer__cod">Paiement à la livraison, partout en Tunisie.</p>
    </div>

    <nav class="footer__col" aria-label="Rayons">
      <h3 class="footer__title">Rayons</h3>
      <ul>
        {departments.map((d) => <li><a href={`/c/${d.path}`}>{d.name}</a></li>)}
        <li><a href="/catalogue">Tout le catalogue</a></li>
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Bonnes affaires">
      <h3 class="footer__title">Bonnes affaires</h3>
      <ul>
        {deals.map((c) => <li><a href={`/bonnes-affaires/${c.slug}`}>{c.title}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Boutique">
      <h3 class="footer__title">Boutique</h3>
      <ul>
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/a-propos#livraison">Livraison et paiement</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer__legal">
    <span>© {year} BuonaFortuna</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: 72px;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 32px;
    padding-block: 44px 28px;
  }
  .footer__brand p {
    margin-top: 12px;
    max-width: 36ch;
    font-size: 14px;
  }
  .footer__cod {
    font-weight: 600;
    color: var(--ink);
  }
  .footer__title {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .footer__col a {
    font-size: 14px;
    color: var(--ink-soft);
  }
  .footer__col a:hover {
    color: var(--red);
  }
  .footer__legal {
    padding-block: 16px 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-faint);
  }
  @media (max-width: 767px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
