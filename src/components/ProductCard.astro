---
/**
 * One piece in a grid. The whole card is a single link; status is shown, not
 * hidden — a reserved or sold piece still appears where it is linked from.
 */
import { formatPrice } from '../lib/shop';

interface Props {
  product: {
    slug: string;
    name: string;
    brand: string;
    size: string;
    condition: string;
    price: number;
    compareAtPrice?: number | null;
    images: { url: string }[];
    status: 'available' | 'reserved' | 'sold';
    tag?: string | null;
  };
  /** First few cards above the fold load eagerly. */
  eager?: boolean;
}

const { product: p, eager = false } = Astro.props;
const cover = p.images[0]?.url ?? '';
---

<article class="pc">
  <a href={`/p/${p.slug}`} class="pc__link">
    <div class="pc__media">
      <img
        src={cover}
        alt={`${p.name}, ${p.brand}, taille ${p.size}`}
        width="400"
        height="500"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {p.status === 'reserved' && <span class="chip chip--amber pc__status">Réservé</span>}
      {p.status === 'sold' && <span class="chip chip--ink pc__status">Vendu</span>}
      {p.status === 'available' && p.tag && <span class="chip chip--ink pc__status">{p.tag}</span>}
      <span class="chip chip--paper pc__condition">{p.condition}</span>
    </div>
    <div class="pc__body">
      <p class="pc__meta">{p.brand} · Taille {p.size}</p>
      <h3 class="pc__name">{p.name}</h3>
      <p class="pc__price">
        <span class="price">{formatPrice(p.price)}</span>
        {p.compareAtPrice && <span class="price--was small">{formatPrice(p.compareAtPrice)}</span>}
      </p>
    </div>
  </a>
</article>

<style>
  .pc {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .pc:hover {
    border-color: var(--line-strong);
  }
  .pc__link {
    display: block;
    color: inherit;
  }
  .pc__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--line);
  }
  .pc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pc:hover .pc__media img {
    filter: brightness(0.97);
  }
  .pc__status {
    position: absolute;
    top: 10px;
    left: 10px;
  }
  .pc__condition {
    position: absolute;
    bottom: 10px;
    left: 10px;
  }
  .pc__body {
    padding: 12px 14px 14px;
  }
  .pc__meta {
    font-size: 12px;
    color: var(--ink-faint);
  }
  .pc__name {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 2px;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc__price {
    margin-top: 8px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 15px;
  }
</style>
