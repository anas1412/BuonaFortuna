---
/**
 * Filter rail + product grid, shared by the catalogue, category pages and the
 * « bonnes affaires » collections.
 *
 * Every filter is a link that rewrites the query string: crawlable, shareable,
 * works with JavaScript disabled. The category section shows the subtree of
 * wherever you are — departments at the root, rayons inside a department,
 * types inside a rayon — and only the nodes that have stock. On small screens
 * the rail folds into a native <details>. Sorting isn't a filter, so it sits
 * above the grid instead.
 */
import ProductCard from './ProductCard.astro';
import { BUDGETS, SORTS, readFilters } from '../lib/filters';
import { hasSizeFacet, orderSizes, sizeScale } from '../lib/sizes';
import { CONDITIONS } from '../lib/shop';

type Node = { _id: string; name: string; path: string; level: number; parentId?: string; count: number };
type Product = Parameters<typeof ProductCard>[0]['product'] & { _id: string };

interface Props {
  basePath: string;
  tree: Node[];
  /** The category we're inside, if any. */
  current?: Node | null;
  products: Product[];
  sizes: string[];
  params: URLSearchParams;
}

const { basePath, tree, current = null, products, sizes, params } = Astro.props;

const showSizes = hasSizeFacet(current?.path);
const filters = readFilters(params, { sizes: showSizes });
const selectedConditions: string[] = filters.conditions ?? [];
const selectedSizes = filters.sizes ?? [];
const budget = filters.maxPrice;
const q = filters.q ?? '';
const sortKey = SORTS.find((s) => s.value === filters.sort)!.key;
const scale = showSizes ? sizeScale(current!.path) : null;
const sizeOptions = scale ? orderSizes(sizes, scale) : [];

// What to list in the category section: children of the current node, or the departments.
const children = tree.filter((c) => (current ? c.parentId === current._id : c.level === 1) && c.count > 0);
const parent = current?.parentId ? tree.find((c) => c._id === current.parentId) ?? null : null;
const categoryTitle = current ? `Dans « ${current.name} »` : 'Rayons';

/** Build a URL with one multi-value param toggled, everything else kept. */
function toggle(key: string, value: string) {
  const next = new URLSearchParams(params);
  const cur = next.getAll(key);
  next.delete(key);
  const set = cur.includes(value) ? cur.filter((v) => v !== value) : [...cur, value];
  for (const v of set) next.append(key, v);
  const qs = next.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}

function withParam(key: string, value: string | null) {
  const next = new URLSearchParams(params);
  if (value === null || (key === 'tri' && value === SORTS[0].key)) next.delete(key);
  else next.set(key, value);
  const qs = next.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}

/** Category links keep the filters that still make sense elsewhere (not search, not sizes). */
function categoryHref(path: string | null) {
  const keep = new URLSearchParams(params);
  keep.delete('q');
  keep.delete('taille');
  const qs = keep.toString();
  const base = path === null ? '/catalogue' : `/c/${path}`;
  return qs ? `${base}?${qs}` : base;
}

const filterCount = selectedConditions.length + selectedSizes.length + (budget ? 1 : 0) + (q ? 1 : 0);
// « Effacer » clears the filters but keeps the chosen order.
const resetHref = sortKey === SORTS[0].key ? basePath : `${basePath}?tri=${sortKey}`;
---

<div class="cat">
  <details class="cat__rail">
    <summary class="cat__summary">
      <span>Filtres</span>
      {filterCount > 0 && <span class="chip chip--red">{filterCount}</span>}
    </summary>

    <div class="cat__groups">
      <section class="cat__group">
        <h3 class="cat__title">{categoryTitle}</h3>
        <ul class="cat__list">
          {
            current && (
              <li>
                <a href={categoryHref(parent ? parent.path : null)} class="cat__item cat__up">
                  ← {parent ? parent.name : 'Tout le catalogue'}
                </a>
              </li>
            )
          }
          {
            children.map((c) => (
              <li>
                <a href={categoryHref(c.path)} class="cat__item">
                  <span>{c.name}</span>
                </a>
              </li>
            ))
          }
          {current && children.length === 0 && <li class="cat__item muted">Toutes les pièces sont ici.</li>}
        </ul>
      </section>

      <section class="cat__group">
        <h3 class="cat__title">État</h3>
        <ul class="cat__list">
          {
            CONDITIONS.map((c) => {
              const on = selectedConditions.includes(c);
              return (
                <li>
                  <a href={toggle('etat', c)} class:list={['cat__item', 'cat__check', { 'is-active': on }]} rel="nofollow">
                    <span class="cat__box" aria-hidden="true"></span>
                    {c}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="cat__group">
        <h3 class="cat__title">Budget</h3>
        <ul class="cat__list">
          {
            BUDGETS.map((b) => {
              const on = budget === b * 1000;
              return (
                <li>
                  <a href={withParam('budget', on ? null : String(b))} class:list={['cat__item', 'cat__radio', { 'is-active': on }]} rel="nofollow">
                    <span class="cat__dot" aria-hidden="true"></span>
                    Moins de {b} DT
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      {
        (sizeOptions.length > 1 || selectedSizes.length > 0) && (
          <section class="cat__group">
            <h3 class="cat__title">{scale!.label}</h3>
            <ul class="cat__sizes">
              {sizeOptions.map((s) => (
                <li>
                  <a href={toggle('taille', s)} class:list={['cat__size', { 'is-active': selectedSizes.includes(s) }]} rel="nofollow">
                    {s}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {filterCount > 0 && <a href={resetHref} class="cat__reset" rel="nofollow">Effacer les filtres</a>}
    </div>
  </details>

  <div class="cat__main">
    <div class="cat__bar">
      <p class="cat__count">
        {products.length} {products.length === 1 ? 'article' : 'articles'}
        {q && <> pour « <strong>{q}</strong> »</>}
      </p>
      <nav class="cat__sort" aria-label="Trier">
        <span>Trier :</span>
        {
          SORTS.map((s) => (
            <a href={withParam('tri', s.key)} class:list={{ 'is-active': sortKey === s.key }} aria-current={sortKey === s.key ? 'true' : undefined} rel="nofollow">
              {s.label}
            </a>
          ))
        }
      </nav>
    </div>

    {
      products.length > 0 ? (
        <div class="grid">
          {products.map((p, i) => (
            <ProductCard product={p} eager={i < 4} />
          ))}
        </div>
      ) : (
        <div class="cat__empty">
          <h2>Rien ne correspond</h2>
          <p class="muted">Essayez un autre mot ou retirez un filtre — de nouvelles pièces arrivent chaque semaine.</p>
          <a href={basePath} class="btn btn--outline">Tout afficher</a>
        </div>
      )
    }
  </div>
</div>

<style>
  .cat {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .cat__rail {
    position: sticky;
    top: 88px;
  }
  .cat__summary {
    display: none;
  }
  .cat__groups {
    display: grid;
    gap: 26px;
  }
  .cat__title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .cat__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .cat__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .cat__check,
  .cat__radio {
    justify-content: flex-start;
  }
  .cat__item:hover {
    color: var(--ink);
  }
  .cat__item.is-active {
    color: var(--red);
    font-weight: 600;
  }
  .cat__up {
    color: var(--ink-faint);
    font-size: 13px;
    justify-content: flex-start;
  }
  .cat__box,
  .cat__dot {
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: 4px;
    flex: none;
  }
  .cat__dot {
    border-radius: 50%;
  }
  .is-active .cat__box,
  .is-active .cat__dot {
    background: var(--red);
    border-color: var(--red);
    box-shadow: inset 0 0 0 3px var(--paper);
  }
  .cat__sizes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cat__size {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--paper);
  }
  .cat__size.is-active {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }
  .cat__reset {
    font-size: 13px;
    font-weight: 600;
    color: var(--red);
  }
  .cat__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 16px;
    font-size: 14px;
  }
  .cat__count {
    color: var(--ink-faint);
  }
  .cat__sort {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    color: var(--ink-faint);
  }
  .cat__sort a {
    color: var(--ink-soft);
    font-weight: 600;
  }
  .cat__sort a:hover,
  .cat__sort a.is-active {
    color: var(--red);
  }
  .cat__empty {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding: 48px 0;
    max-width: 44ch;
  }

  /* Desktop: the <details> stays closed but its content shows anyway. */
  @media (min-width: 900px) {
    .cat__rail::details-content {
      content-visibility: visible;
      display: contents;
    }
  }

  @media (max-width: 899px) {
    .cat {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .cat__rail {
      position: static;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
    }
    .cat__summary {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .cat__summary::-webkit-details-marker {
      display: none;
    }
    .cat__summary::after {
      content: '';
      margin-left: auto;
      width: 8px;
      height: 8px;
      border-right: 2px solid var(--ink-faint);
      border-bottom: 2px solid var(--ink-faint);
      transform: rotate(45deg);
    }
    details[open] .cat__summary::after {
      transform: rotate(-135deg);
    }
    .cat__groups {
      padding: 4px 16px 16px;
      gap: 18px;
    }
  }
</style>
